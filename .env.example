# Required to run agents. User key from https://cursor.com/dashboard/api
# or a team service-account key. Anyone with the workspace URL can spend this key.
CURSOR_API_KEY=cursor_...

# Optional: prefill / seed a default workspace on boot
CURSOR_PARTY_REPO_URL=https://github.com/your-org/your-repo
CURSOR_PARTY_STARTING_REF=main
CURSOR_PARTY_WORKSPACE_NAME=CursorParty

# SQLite (libsql file URL)
DATABASE_URL=file:./data/cursorparty.db

HOST=0.0.0.0
PORT=3000

# debug, info, warn, or error. Defaults to debug in development and info in production.
LOG_LEVEL=debug
